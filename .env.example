# ============================================================================
# base_template — biến môi trường
#
# Copy file này thành `.env` rồi sửa. Mỗi khối ghi rõ: BẮT BUỘC hay tuỳ chọn,
# và điều gì xảy ra nếu bỏ trống.
#
# Sinh chuỗi bí mật:  openssl rand -base64 48
# ============================================================================

NODE_ENV=development

# ----------------------------------------------------------------------------
# BẮT BUỘC
# ----------------------------------------------------------------------------

# Chuỗi kết nối PostgreSQL. Trùng với docker-compose.yml bên dưới.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/base_template?schema=public"

# Khoá ký JWT. KHÔNG có giá trị mặc định trong code — thiếu là app không khởi
# động, và đó là chủ ý: một khoá mặc định nằm công khai trong mã nguồn nghĩa là
# bất kỳ ai cũng tự tạo được token quản trị hợp lệ.
JWT_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu-openssl-rand-base64-48"

# URL công khai của WEB (không phải của API). Dùng để dựng link trong email.
# Bỏ trống thì luồng email ném lỗi rõ ràng thay vì gửi đi một link localhost.
APP_URL="http://localhost:3000"

# Tên sản phẩm — hiển thị trong app xác thực (Google Authenticator…) khi người
# dùng bật 2FA, và làm tên người gửi mặc định.
APP_NAME="Base Template"

# Khoá mã hoá bí mật lưu trong database (hiện dùng cho khoá TOTP của 2FA).
# Sinh bằng:  openssl rand -base64 32
#
# Bỏ trống thì 2FA KHÔNG bật được (giao diện tự ẩn nút), phần còn lại chạy bình
# thường.
#
# ⚠️ ĐỔI GIÁ TRỊ NÀY SAU KHI ĐÃ CÓ DỮ LIỆU = hỏng mọi bí mật đã mã hoá, người
# dùng phải cài lại 2FA từ đầu. Đặt một lần rồi giữ nguyên, sao lưu cùng chỗ
# với JWT_SECRET.
ENCRYPTION_KEY=""

# --- Passkey (WebAuthn) -----------------------------------------------------
# Bỏ trống cả hai = suy ra từ APP_URL. Đúng cho phần lớn dự án.
#
# ⚠️ WEBAUTHN_RP_ID là TÊN MIỀN mà passkey gắn vào, và nó rất khắt khe:
#   • Passkey đăng ký ở app.example.com KHÔNG dùng được ở example.com nếu
#     RP ID là app.example.com.
#   • Đặt RP ID = example.com thì dùng được ở mọi tên miền con — tiện, nhưng
#     một tên miền con bị chiếm cũng xin được chữ ký.
#   • ĐỔI giá trị này sau khi đã có người đăng ký = mọi passkey cũ chết.
WEBAUTHN_RP_ID=""
# Danh sách origin được chấp nhận, phân tách bằng dấu phẩy. Chỉ cần khai khi
# app mobile cũng dùng passkey (Android gửi origin dạng android:apk-key-hash:…).
WEBAUTHN_ORIGINS=""

# URL công khai của chính API. Bỏ trống = lấy theo APP_URL, đúng khi web và API
# nằm sau CÙNG một tên miền.
# ⚠️ BẮT BUỘC đặt khi API ở tên miền riêng (vd https://api.example.com) — nếu
# không, redirect_uri của OAuth sẽ trỏ vào tên miền web và không có route nào ở đó.
API_PUBLIC_URL=""

# Origin được phép gọi API, phân tách bằng dấu phẩy.
# `*` KHÔNG dùng được trên production — env.ts chặn từ lúc khởi động.
CORS_ORIGIN="http://localhost:3000"

# ----------------------------------------------------------------------------
# API (apps/api)
# ----------------------------------------------------------------------------
PORT=3001

# Swagger tại /docs. Mặc định BẬT ở dev, TẮT trên production.
# ENABLE_SWAGGER=true

# Rate limit chung cho mọi endpoint (lớp thô, đếm trong RAM).
# Endpoint nhạy cảm có ngưỡng riêng chặt hơn — xem RATE_LIMITS trong @repo/core.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Kích thước body tối đa (byte). Nhỏ có chủ đích: API nhận JSON, tệp đi thẳng
# lên S3 bằng presigned URL.
BODY_LIMIT_BYTES=1048576

# ----------------------------------------------------------------------------
# WEB (apps/web)
# ----------------------------------------------------------------------------

# Web gọi API qua địa chỉ này. Trong Docker là tên service (`http://api:3001`).
API_URL="http://localhost:3001"

# ----------------------------------------------------------------------------
# Hạn của các loại token
# ----------------------------------------------------------------------------

# Access token ngắn có chủ đích: JWT đã ký thì KHÔNG thu hồi được, nên hạn của
# nó chính là thứ giới hạn thiệt hại khi bị lộ.
ACCESS_TOKEN_TTL_MINUTES=15

# Refresh token dài hơn nhiều, nhưng nằm trong database nên thu hồi được ngay.
REFRESH_TOKEN_TTL_DAYS=30

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
PHONE_OTP_TTL_MINUTES=5

# --- Xác thực số điện thoại (SMS) -------------------------------------------
# ⚠️ KHÁC EMAIL: MỖI TIN NHẮN TỐN TIỀN THẬT. Vì vậy mặc định TẮT.
#
# Bật lên thì phải cắm nhà cung cấp thật bằng setSmser() trong
# apps/api/src/main.ts (eSMS / Viettel / VNPT / Twilio — bộ khung không chọn hộ).
# Chưa cắm: dev ghi mã ra log, production NÉM LỖI.
PHONE_VERIFICATION_ENABLED=0
# Trần SMS gửi tới MỘT số điện thoại trong 24h. Đây là lớp chặn quan trọng nhất
# về chi phí: rate limit theo IP không cản được kẻ xoay vòng IP.
PHONE_OTP_MAX_PER_DAY=5
# Giãn cách tối thiểu giữa hai lần gửi tới cùng một số.
PHONE_OTP_RESEND_COOLDOWN_SECONDS=60

# Hạn của "vé" 2FA — token trung gian cấp sau khi mật khẩu đúng nhưng chưa nhập
# mã. Ngắn có chủ đích: nó chứng minh "vừa nhập đúng mật khẩu".
TWO_FACTOR_CHALLENGE_TTL_MINUTES=5

# Số lần nhập SAI tối đa cho MỘT mã dùng-một-lần (OTP, mã khôi phục 2FA).
# Chốt chặn độc lập với rate limit theo IP: rate limit chặn một IP dò nhiều tài
# khoản, ngưỡng này chặn nhiều IP cùng dò một mã 6 chữ số. Chạm ngưỡng thì mã
# bị huỷ, phải xin mã mới.
VERIFICATION_MAX_ATTEMPTS=5

# --- Chính sách lưu trữ (job dọn dẹp hằng ngày, xem PURGE_CRON) -------------
# Bốn bảng chỉ-tăng (refresh token, verification token, audit log, thiết bị) đều
# được dọn theo các mốc này. Không dọn thì chúng lớn âm thầm cho tới ngày truy
# vấn bắt đầu chậm.
AUDIT_RETENTION_DAYS=365
DEVICE_STALE_DAYS=180

# Thu hồi TỨC THÌ mọi access token cũ khi mật khẩu đổi (so `iat` với
# `passwordChangedAt`). Không bật thì kẻ đã chiếm tài khoản còn thao tác được
# tới 15 phút sau khi chủ thật đổi mật khẩu. Giá: một lần đọc cache mỗi request.
SESSION_STRICT_REVOCATION=1

# Chống brute-force theo TÀI KHOẢN (bổ sung cho rate limit theo IP).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ----------------------------------------------------------------------------
# Redis — cache, rate limit dùng chung, hàng đợi
# ----------------------------------------------------------------------------

# Bỏ trống = cache và rate limit chạy trong RAM của TỪNG tiến trình. Đủ cho một
# instance; từ instance thứ hai trở đi mỗi bản đếm riêng, nên ngưỡng thực tế bị
# nhân lên — và mỗi lần deploy là bộ đếm về 0.
REDIS_URL="redis://localhost:6379"

# ----------------------------------------------------------------------------
# Hàng đợi & worker (apps/worker)
# ----------------------------------------------------------------------------

# 1 = job chạy nền ở apps/worker (có THỬ LẠI tự động).
# 0 = job chạy thẳng trong request; không cần Redis, không cần worker, nhưng
#     mất thử lại và người dùng phải chờ.
#
# ⚠️ CHỈ nhận 1 hoặc 0: docker-compose dùng chính biến này làm số `replicas`,
# và Compose chỉ hiểu số.
QUEUE_ENABLED=1

WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=3002
# Dọn token hết hạn mỗi ngày lúc 3 giờ sáng (giờ thấp điểm).
PURGE_CRON="0 3 * * *"

# ----------------------------------------------------------------------------
# Email
# ----------------------------------------------------------------------------

# Bỏ trống SMTP_HOST: ở dev email chỉ được GHI RA LOG (tiện lấy link xác thực),
# còn trên production thì NÉM LỖI — im lặng nuốt email là hành vi nguy hiểm.
#
# Dev: `docker compose up mailpit` rồi mở http://localhost:8025 để đọc thư.
SMTP_HOST=""
SMTP_PORT=587
# 1 = TLS ngay từ đầu (cổng 465). Cổng 587 dùng STARTTLS nên để 0.
SMTP_SECURE=0
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Base Template <no-reply@example.com>"

# ----------------------------------------------------------------------------
# Kho tệp — S3 / MinIO / Cloudflare R2 / Vietnix
# ----------------------------------------------------------------------------
# Bỏ trống thì endpoint xin link upload trả lỗi rõ ràng. KHÔNG có bản "lưu vào
# ổ đĩa local": nó chạy được trên máy dev rồi hỏng ngay khi lên nhiều instance.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# 1 với MinIO và phần lớn nhà cung cấp trong nước (bucket nằm trong đường dẫn).
S3_FORCE_PATH_STYLE=0
# Tên miền CDN đặt trước bucket, nếu có.
S3_PUBLIC_URL=""

# ----------------------------------------------------------------------------
# Đăng nhập mạng xã hội (OAuth)
# ----------------------------------------------------------------------------
# Mỗi nhà cung cấp độc lập: thiếu cặp ID/SECRET nào thì RIÊNG nút đó báo "chưa
# cấu hình", app vẫn chạy bình thường.
#
# redirect_uri phải khai đúng trên console của họ:
#   {APP_URL}/api/v1/auth/oauth/{provider}/callback

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Apple không có client secret tĩnh — nó là JWT tự ký bằng private key .p8.
# Dán nội dung .p8 vào APPLE_PRIVATE_KEY, xuống dòng viết thành \n.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# ----------------------------------------------------------------------------
# Tài khoản quản trị đầu tiên (dùng cho `pnpm db:seed`)
# ----------------------------------------------------------------------------
# Bỏ trống thì seed bỏ qua bước tạo admin và nói rõ ra. Cố ý KHÔNG có tài khoản
# mặc định trong code: một cặp admin/admin123 viết cứng sẽ theo dự án lên tận
# production.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ----------------------------------------------------------------------------
# Docker Compose
# ----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=base_template
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=3000
