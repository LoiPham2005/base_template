PORT=3001

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/base_template?schema=public"

# BẮT BUỘC — cố ý không có giá trị mặc định.
# Sinh khoá riêng cho từng môi trường:  openssl rand -base64 48
# Đừng dùng chung khoá giữa dev và production: lộ khoá dev là lộ luôn production.
JWT_SECRET=""

JWT_EXPIRES_IN="7d"

# Danh sách origin, phân tách bằng dấu phẩy.
# `*` chỉ dùng được ở dev — app TỪ CHỐI khởi động nếu NODE_ENV=production mà
# biến này vẫn là `*`, vì wildcard đi kèm credentials là cấu hình mâu thuẫn.
# Ví dụ production:  CORS_ORIGIN="https://app.example.com,https://admin.example.com"
CORS_ORIGIN="*"

# Swagger UI tại /docs. Trên production, /docs công khai là tấm bản đồ cho
# người dò hệ thống — chỉ bật khi thật sự cần.
ENABLE_SWAGGER="true"

# Tài khoản admin do `pnpm db:seed` tạo. Bắt buộc khi seed trên production.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
