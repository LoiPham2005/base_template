{
  "name": "base-template",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:deploy": "pnpm --filter @repo/db migrate:deploy",
    "db:seed": "pnpm --filter @repo/db seed",
    "db:studio": "pnpm --filter @repo/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "scaffold:api-only": "node scripts/scaffold.js api-only",
    "scaffold:api-only:apply": "node scripts/scaffold.js api-only --yes",
    "scaffold:solo": "node scripts/scaffold.js solo",
    "scaffold:solo:apply": "node scripts/scaffold.js solo --yes",
    "deploy:vps": "bash deploy-vps.sh",
    "deploy:docker": "bash deploy-docker.sh"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yaml,yml}": "prettier --write"
  }
}
