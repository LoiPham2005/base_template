{
  "name": "base-template",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:studio": "pnpm --filter @repo/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "scaffold:api-only": "node scripts/scaffold.js api-only",
    "scaffold:api-only:apply": "node scripts/scaffold.js api-only --yes",
    "scaffold:solo": "node scripts/scaffold.js solo",
    "scaffold:solo:apply": "node scripts/scaffold.js solo --yes"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
