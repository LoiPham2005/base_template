// Prisma schema shared by every app. Only packages/core is allowed
// to import the generated client (enforced by @repo/eslint-config).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Swap to "mysql" / "sqlite" / "mongodb" here if a project needs it —
  // nothing outside this file depends on the provider.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Argon2 hash. Null nghĩa là tài khoản chưa đặt mật khẩu (admin tạo hộ,
  /// hoặc đăng nhập qua OAuth) — khác hẳn chuỗi rỗng, vốn là một mật khẩu
  /// "hợp lệ" nhìn từ tầng dữ liệu.
  password  String?
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Danh sách sắp xếp theo createdAt desc; không có index thì mỗi lần mở
  // trang là một lần full table scan kèm sort.
  @@index([createdAt])
  @@map("users")
}

