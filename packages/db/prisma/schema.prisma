// Schema dùng chung cho toàn bộ monorepo.
//
// CHỈ packages/core được import Prisma Client (ràng buộc này do
// @repo/eslint-config enforce trên apps/api và apps/web).
//
// Bố cục:
//   1. RBAC        — Role / Permission / gán theo vai trò & theo từng người
//   2. Người dùng  — User (chỉ phục vụ xác thực) + UserProfile + 2FA
//   3. Phiên & token — OAuthAccount / RefreshToken / VerificationToken
//   4. Thiết bị & thông báo
//   5. Nhật ký kiểm toán
//
// ---
// QUY ƯỚC: MỌI CỘT THỜI GIAN LÀ `Timestamptz`
//
// Mặc định của Prisma là `timestamp(3)` KHÔNG có múi giờ. Đi qua Prisma thì
// vẫn đúng (nó quy về UTC), nhưng khoảnh khắc có một câu SQL viết tay, một
// công cụ như DBeaver, hay một `DEFAULT now()` phía database chen vào là giá
// trị lệch đi vài tiếng mà không có gì báo. Với hệ thống xác thực — nơi
// `expiresAt` và `lockedUntil` quyết định ai vào được — đó là loại lỗi tệ nhất.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Đổi sang "mysql" / "sqlite" ở đây nếu dự án cần — không file nào ngoài
  // file này phụ thuộc vào provider.
  //
  // ⚠️ Ngoại lệ: các partial unique index trong migration init là cú pháp
  // PostgreSQL. Đổi provider thì phải viết lại chúng.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. PHÂN QUYỀN (RBAC): NHIỀU VAI TRÒ + QUYỀN CHI TIẾT
// ============================================================

/// Vai trò. DANH SÁCH vai trò nằm trong database (quản trị viên tạo thêm được
/// lúc chạy); DANH MỤC quyền thì nằm trong code (@repo/contracts) — xem ghi chú
/// đầu file packages/contracts/src/permissions.ts để hiểu vì sao chia như vậy.
model Role {
  id          String  @id @default(cuid())
  /// Mã cố định, viết HOA: SUPER_ADMIN, ADMIN, USER… Đây là thứ code so sánh,
  /// còn `name` chỉ để hiển thị.
  key         String  @unique
  name        String
  description String?

  /// BẬC QUYỀN LỰC. Cao hơn = mạnh hơn.
  ///
  /// Đây là thứ ngăn leo thang đặc quyền. Không có nó, bất kỳ ai có quyền
  /// `user:create` đều tạo được một tài khoản mang vai trò SUPER_ADMIN rồi
  /// đăng nhập vào đó — chốt "không tự đổi vai trò của chính mình" không cứu
  /// được, vì họ tạo tài khoản KHÁC.
  ///
  /// Luật (áp trong UserService): chỉ gán/gỡ được vai trò có `level` THẤP HƠN
  /// HẲN bậc cao nhất của chính mình, và không đụng được vào người có bậc
  /// bằng hoặc cao hơn mình.
  ///
  /// Thang mặc định của seed: USER 0 · STAFF 10 · MANAGER 20 · ADMIN 50 ·
  /// SUPER_ADMIN 100. Chừa khoảng trống để chèn vai trò mới vào giữa.
  level       Int     @default(0)

  /// Vai trò cốt lõi — không cho xoá, không cho đổi key. Xoá vai trò đang được
  /// gán cho người dùng là cách nhanh nhất để khoá toàn bộ hệ thống khỏi
  /// chính người quản trị.
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  userRoles   UserRole[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([level])
  @@map("roles")
}

/// Quyền hạn. Bảng này được ĐỒNG BỘ TỪ CODE bằng `pnpm db:seed` — đừng thêm
/// dòng bằng tay, vì một quyền không có dòng mã nào kiểm tra thì tick vào cũng
/// không thay đổi điều gì.
model Permission {
  id          String  @id @default(cuid())
  /// Quy ước: `<tài-nguyên>:<hành-động>`, thêm `:own` khi chỉ áp dụng cho dữ
  /// liệu của chính người đó. Ví dụ: `user:read`, `profile:update:own`.
  key         String  @unique
  name        String
  /// Nhóm hiển thị trên màn phân quyền: "Quản lý Người dùng", "Đơn hàng"…
  category    String
  description String?

  roles           RolePermission[]
  userPermissions UserPermission[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Một người có thể mang NHIỀU vai trò. Quyền cuối cùng là HỢP của mọi vai trò
/// (rồi mới áp các dòng UserPermission bên dưới) — xem PermissionService.
model UserRole {
  userId String
  roleId String
  /// Ai đã gán vai trò này. Chuỗi trần, KHÔNG có khoá ngoại — cùng lý do với
  /// `AuditLog.actorId`: dấu vết phải sống lâu hơn người để lại nó.
  assignedBy String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Ngoại lệ cho từng cá nhân, đè lên quyền đến từ vai trò.
///
/// `isGranted = false` (TƯỚC quyền) luôn THẮNG mọi vai trò. Đây là lựa chọn có
/// chủ đích: cần chặn gấp một người khỏi một hành động thì phải chặn được ngay,
/// không phải đi gỡ họ khỏi vai trò rồi dựng lại một vai trò gần giống.
model UserPermission {
  userId       String
  permissionId String
  isGranted    Boolean  @default(true)
  grantedBy    String?

  /// Hạn của ngoại lệ này. `null` = vĩnh viễn.
  ///
  /// "Cấp quyền này trong 24 giờ để xử lý sự cố" là nhu cầu rất thường gặp, và
  /// không có cột này thì nó âm thầm thành vĩnh viễn — không ai nhớ quay lại
  /// gỡ, và cũng không có gì nhắc.
  expiresAt    DateTime? @db.Timestamptz(3)

  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@index([expiresAt])
  @@map("user_permissions")
}

// ============================================================
// 2. NGƯỜI DÙNG
// ============================================================

enum UserStatus {
  /// Đang hoạt động.
  ACTIVE
  /// Chưa kích hoạt hoặc tạm ngưng — đăng nhập được nhưng nên bị chặn ở tầng
  /// nghiệp vụ nếu dự án yêu cầu xác thực email trước.
  INACTIVE
  /// Bị khoá do vi phạm. Chặn MỌI đường đăng nhập, kể cả OAuth.
  BANNED
}

/// Bảng User cố tình giữ mỏng: CHỈ phục vụ xác thực và bảo mật.
///
/// Mọi thông tin cá nhân (tên, ảnh, địa chỉ…) nằm ở `UserProfile`. Tách ra vì
/// bảng này bị đọc ở gần như mọi request xác thực, còn hồ sơ thì hiếm khi cần
/// — và vì thông tin cá nhân là thứ chịu ràng buộc pháp lý (xoá theo yêu cầu,
/// xuất dữ liệu), dễ xử lý hơn nhiều khi nó nằm gọn một chỗ.
///
/// ---
/// ⚠️ `email` / `phone` / `username` KHÔNG dùng `@unique` CỦA PRISMA
///
/// Chúng được ràng buộc bằng **partial unique index** viết tay trong migration:
///
///     CREATE UNIQUE INDEX users_email_active_key
///       ON users (email) WHERE deleted_at IS NULL;
///
/// Vì sao: `@unique` thường áp cho CẢ dòng đã xoá mềm. Nghĩa là xoá một tài
/// khoản xong thì địa chỉ email đó vĩnh viễn không ai đăng ký lại được — kể cả
/// chính chủ. Cách chữa phổ biến là bóp méo email lúc xoá
/// (`a@b.com:deleted:1699…`), nhưng như vậy là làm hỏng dữ liệu thật chỉ để
/// lách một ràng buộc.
///
/// HỆ QUẢ PHẢI NHỚ: Prisma không biết về index đó, nên
/// `prisma.user.findUnique({ where: { email } })` KHÔNG biên dịch được. Dùng
/// `findFirst` kèm `deletedAt: null`. Database vẫn từ chối trùng và vẫn ném
/// P2002 như thường.
model User {
  id       String  @id @default(cuid())
  email    String?
  phone    String?
  username String?
  /// Hash Argon2id. Bộ khung KHÔNG hỗ trợ thuật toán nào khác — một hash lạ
  /// lọt vào đây chỉ dẫn tới "sai mật khẩu", không làm hỏng gì.
  /// `null` = tài khoản chưa đặt mật khẩu: admin tạo hộ, hoặc chỉ đăng nhập
  /// qua OAuth. Khác hẳn chuỗi rỗng — vốn là một mật khẩu "hợp lệ" nhìn từ
  /// tầng dữ liệu.
  password String?

  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @db.Timestamptz(3)
  phoneVerifiedAt DateTime?  @db.Timestamptz(3)

  /// Địa chỉ email MỚI đang chờ xác thực.
  ///
  /// Đổi email là đường chiếm tài khoản kinh điển, nên nó không bao giờ được
  /// ghi thẳng vào `email`: địa chỉ mới phải tự chứng minh quyền sở hữu trước
  /// (VerificationToken loại EMAIL_CHANGE), và địa chỉ CŨ được gửi thư báo để
  /// chủ thật còn kịp phản ứng.
  pendingEmail String?

  /// Số lần sai mật khẩu LIÊN TIẾP. Reset về 0 khi đăng nhập thành công.
  failedLoginAttempts Int       @default(0)
  /// Khoá tạm do brute-force, tự hết hạn. Khác `status = BANNED` (khoá tay).
  lockedUntil         DateTime? @db.Timestamptz(3)
  /// Xoá mềm. Mọi truy vấn xác thực phải lọc `deletedAt: null`.
  deletedAt           DateTime? @db.Timestamptz(3)

  // --- Xác thực hai lớp (TOTP) ---------------------------------------------

  /// Khoá bí mật TOTP, **đã mã hoá AES-256-GCM** trước khi ghi.
  ///
  /// Không lưu dạng thô có chủ đích: khoá này sinh ra được mã hợp lệ, nên nếu
  /// database bị rò thì 2FA mất tác dụng hoàn toàn. Khoá giải mã nằm ở biến
  /// môi trường `ENCRYPTION_KEY` — tức là ngoài database.
  twoFactorSecret String?

  /// `null` = chưa bật 2FA. Có `twoFactorSecret` mà cột này null nghĩa là
  /// người dùng đang ở giữa luồng cài đặt (đã quét QR, chưa nhập mã xác nhận).
  twoFactorEnabledAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  profile UserProfile?

  userRoles       UserRole[]
  userPermissions UserPermission[]

  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  oauthAccounts      OAuthAccount[]
  recoveryCodes      RecoveryCode[]

  devices       UserDevice[]
  notifications NotificationRecipient[]

  // Index thường (không unique) cho việc TRA CỨU. Ràng buộc duy nhất do
  // partial unique index trong migration đảm nhiệm — xem ghi chú đầu model.
  @@index([email])
  @@index([phone])
  @@index([username])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName  String?
  avatarUrl String?
  gender    Gender?
  dob       DateTime? @db.Date
  bio       String?
  address   String?
  city      String?
  district  String?
  country   String?   @default("VN")
  /// Chỗ nhét thêm field riêng của từng dự án mà không phải viết migration.
  /// Đừng lạm dụng: thứ gì cần lọc hoặc sắp xếp thì phải là cột thật.
  metadata  Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("user_profiles")
}

/// Mã khôi phục 2FA — dùng khi mất điện thoại.
///
/// Không có nó thì bật 2FA đồng nghĩa với "mất máy là mất tài khoản", và người
/// dùng sẽ không bật. Mỗi mã dùng ĐÚNG MỘT LẦN.
///
/// `codeHash` băm kèm `userId` (xem `hashScopedToken`), nên hai người có thể
/// bốc trúng cùng một mã mà không đụng nhau — mã khôi phục ngắn hơn token
/// trong email nên khả năng trùng là có thật.
model RecoveryCode {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String
  usedAt   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, codeHash])
  @@index([userId])
  @@map("recovery_codes")
}

// ============================================================
// 3. OAUTH, TOKEN & PHIÊN ĐĂNG NHẬP
// ============================================================

/// ⚠️ Cố ý KHÔNG lưu access/refresh token của nhà cung cấp.
///
/// Chúng chỉ cần khi bạn gọi API của Google/Facebook THAY MẶT người dùng (đọc
/// lịch, đăng bài). Dùng OAuth thuần để đăng nhập thì lưu chúng là ôm thêm một
/// kho bí mật giá trị cao mà không đổi lại được gì. Cần thì thêm sau, và nhớ
/// mã hoá như `User.twoFactorSecret`.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// google | github | facebook | apple
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Refresh token cho client mobile/SPA. Chỉ lưu SHA-256 — rò database không
/// đồng nghĩa với rò phiên đăng nhập.
model RefreshToken {
  id        String @id @default(cuid())

  /// ĐỊNH DANH PHIÊN, ổn định xuyên suốt mọi lần xoay vòng.
  ///
  /// Giải hai bài toán cùng lúc:
  ///
  /// 1. Client có một id KHÔNG đổi để nhận ra "thiết bị này" trong màn quản lý
  ///    phiên. Nếu dùng `id` của từng token thì giá trị đó đổi sau mỗi lần
  ///    refresh, và client phải cập nhật liên tục — một wart mà mọi hệ thống
  ///    rotation đều gặp nếu thiếu cột này.
  /// 2. Khi phát hiện token bị dùng lại, thu hồi đúng MỘT họ (một thiết bị bị
  ///    đánh cắp) thay vì đá người dùng ra khỏi mọi thiết bị họ đang có.
  familyId  String

  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  userAgent String?
  ip        String?

  /// Người dùng đã vượt qua 2FA cho phiên này chưa. Phiên cấp từ luồng có 2FA
  /// mang `true`; phiên cấp trước khi bật 2FA thì không.
  twoFactorAt DateTime? @db.Timestamptz(3)

  expiresAt DateTime  @db.Timestamptz(3)
  /// Đặt khi đăng xuất hoặc khi token bị xoay vòng.
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  /// Xác thực địa chỉ email MỚI trước khi thay thế địa chỉ cũ.
  EMAIL_CHANGE
  PHONE_OTP
  PASSWORD_RESET
}

/// Token dùng MỘT LẦN gửi qua email/SMS. Chỉ lưu bản băm.
///
/// ---
/// HAI KIỂU BĂM, KHÔNG PHẢI MỘT
///
///   • Token trong LINK (email) là 256 bit ngẫu nhiên → băm trần. Người dùng
///     chỉ gửi lại mỗi token, nên phải tra cứu được bằng chính nó.
///   • OTP qua SMS chỉ có 6 chữ số → băm KÈM `userId`. Băm trần thì
///     `SHA-256("123456")` là một hằng số: hai người cùng bốc trúng dãy đó sẽ
///     đụng nhau, và tệ hơn — tra cứu bằng hash trần sẽ trả về bản ghi của
///     NGƯỜI KHÁC, tức là đăng nhập nhầm tài khoản.
///
/// Xem `hashOpaqueToken` và `hashScopedToken`.
model VerificationToken {
  id        String                @id @default(cuid())
  tokenHash String                @unique
  type      VerificationTokenType
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nơi mã được gửi tới. Với `EMAIL_CHANGE` đây là địa chỉ MỚI — đó cũng là
  /// nơi duy nhất lưu nó cho tới khi người dùng bấm xác nhận.
  destination String?

  /// Số lần nhập SAI.
  ///
  /// Bắt buộc với OTP: 6 chữ số chỉ có 10^6 khả năng, và rate limit theo IP
  /// không cản được kẻ xoay vòng IP. Chạm ngưỡng thì token bị huỷ, buộc phải
  /// xin mã mới.
  attempts  Int @default(0)

  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ============================================================
// 4. THIẾT BỊ & THÔNG BÁO
// ============================================================

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// ⚠️ `fcmToken` là UNIQUE TOÀN CỤC, không phải unique theo từng người dùng.
///
/// Một FCM token định danh MỘT LẦN CÀI APP TRÊN MỘT MÁY, không phải một cặp
/// (người, máy). Ràng buộc theo `(userId, fcmToken)` cho phép hai dòng cùng
/// token tồn tại song song khi hai tài khoản lần lượt đăng nhập trên cùng một
/// điện thoại — và thông báo riêng tư của người thứ nhất sẽ hiện trên màn hình
/// người thứ hai.
///
/// Đăng ký lại dưới tài khoản khác thì CHUYỂN CHỦ dòng đó (xem DeviceService),
/// không tạo dòng mới.
model UserDevice {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  /// Token nhận push (FCM/APNs).
  fcmToken   String         @unique
  /// UUID phần cứng do client sinh, ổn định qua các lần cài lại app.
  deviceId   String?
  deviceName String?
  isActive   Boolean        @default(true)
  lastSeenAt DateTime       @default(now()) @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)

  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("user_devices")
}

enum NotificationType {
  /// Gửi tới một số người cụ thể.
  DIRECT
  /// Gửi theo nhóm/chủ đề.
  TOPIC
  /// Gửi toàn hệ thống.
  BROADCAST
}

/// Nội dung gốc: MỘT bản ghi dù gửi cho một triệu người.
model Notification {
  id        String           @id @default(cuid())
  title     String
  body      String
  imageUrl  String?
  type      NotificationType @default(DIRECT)
  /// Điều hướng khi bấm: "/orders/123" hoặc URL tuyệt đối.
  actionUrl String?
  data      Json?
  /// Chuỗi trần, không khoá ngoại — cùng lý do với `AuditLog.actorId`.
  senderId  String?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  recipients NotificationRecipient[]

  @@index([type, createdAt])
  @@map("notifications")
}

/// Trạng thái nhận/đọc của từng người. Bảng này mới là thứ bị query liên tục
/// (đếm số chưa đọc trên chuông), nên nó được giữ mỏng và đánh index kỹ.
model NotificationRecipient {
  id             String @id @default(cuid())
  notificationId String
  userId         String

  isRead   Boolean   @default(false)
  readAt   DateTime? @db.Timestamptz(3)
  isPushed Boolean   @default(false)
  pushedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notification_recipients")
}

// ============================================================
// 5. NHẬT KÝ KIỂM TOÁN
// ============================================================

/// Ghi lại HÀNH ĐỘNG NHẠY CẢM, không phải mọi request.
///
/// Nguyên tắc: ghi những việc mà sau này sẽ có người hỏi "ai làm cái này?" —
/// đổi quyền, khoá tài khoản, xoá dữ liệu, đổi mật khẩu người khác. Ghi tất cả
/// mọi thứ thì bảng phình nhanh tới mức không ai tra nổi, tức là mất luôn tác
/// dụng.
///
/// ---
/// ⚠️ KHÔNG CÓ KHOÁ NGOẠI TỚI `users`
///
/// Có chủ đích. Nhật ký phải sống lâu hơn đối tượng nó ghi lại: xoá cứng một
/// tài khoản mà `onDelete: SetNull` xoá luôn `actorId` là mất danh tính của
/// mọi hành động họ từng làm — đúng lúc cần tra nhất. `actorEmail` được chép
/// lại tại thời điểm ghi, nên nhật ký vẫn đọc được sau khi người đó biến mất.
model AuditLog {
  id         String   @id @default(cuid())
  /// null = hệ thống tự làm (cron, webhook). Chuỗi trần, không khoá ngoại.
  actorId    String?
  actorEmail String?
  /// Quy ước: `<thực-thể>.<hành-động>` — "user.banned", "role.updated".
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
